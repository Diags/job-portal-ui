{
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline-command.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/secret-guard.py",
            "statusMessage": "Scanning for hardcoded secrets",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/protect-files.sh",
            "statusMessage": "Checking protected paths",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/line_limit.py",
            "statusMessage": "Checking file length",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code needs your attention\" with title \"Claude Code\"'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
